# Copy to .env (never commit it) or set these in your host's "Secrets" panel.

# --- AI provider: any OpenAI-compatible API -----------------------------------
# Groq (free tier, fast): https://console.groq.com/keys
# gpt-oss-120b tested best on Groq's free tier (Kimi K2 is no longer offered there).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_...
LLM_MODEL=openai/gpt-oss-120b
# OpenRouter alternative (free models end with :free): https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=moonshotai/kimi-k2:free

# --- optional tuning (defaults shown) -----------------------------------------
# SESSION_TTL_SECONDS=3600       # delete a browser's videos 1h after it was last seen
# MAX_FIX_ATTEMPTS=2             # AI repair rounds after a failed render
# RENDER_TIMEOUT_SECONDS=300
# RENDER_WORKERS=1               # parallel renders; raise on bigger machines
# MAX_VIDEO_SECONDS=120
# LLM_DAILY_CALL_LIMIT=500       # protects your free API quota
# MAX_JOBS_PER_SESSION_PER_HOUR=15
# ALLOW_HD=true
