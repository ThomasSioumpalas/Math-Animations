# Copy to .env (never commit it) or set these in your host's "Secrets" panel.
# Never put real keys in this file: it is committed to git.

# --- AI providers: a chain of FREE tiers, tried in this order ------------------
# When one provider is rate-limited or out of daily quota, the next one is used.
# A provider is enabled when its key is set. All keys below are free, no credit card.

# 1. Google Gemini (best free math model): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash   # tried in order; each has its own free quota

# 2. NVIDIA NIM (40 req/min, 10,000 req/day): https://build.nvidia.com  -> "Get API Key"
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b   (Gemma 4 / DeepSeek / GLM-5 there were queued for minutes in tests)

# 3. Z.ai GLM (free Flash models): https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
# ZAI_MODEL=glm-4.7-flash

# 4. OVHcloud (no key needed, 2 req/min per server IP), always on unless disabled
# OVH_ENABLED=true
# OVH_MODEL=Qwen3.5-397B-A17B

# Optional: any other OpenAI-compatible provider, tried last
# CUSTOM_LLM_BASE_URL=
# CUSTOM_LLM_API_KEY=
# CUSTOM_LLM_MODEL=

# --- optional tuning (defaults shown) -----------------------------------------
# SESSION_TTL_SECONDS=3600       # delete a browser's videos 1h after it was last seen
# MAX_FIX_ATTEMPTS=3             # AI repair rounds after a failed render or layout problem
# RENDER_TIMEOUT_SECONDS=480
# RENDER_WORKERS=1               # parallel renders; raise on bigger machines
# MAX_VIDEO_SECONDS=240
# LLM_DAILY_CALL_LIMIT=0         # 0 = no site-wide cap
# LLM_FIRST_TOKEN_SECONDS=75     # a provider silent this long is skipped (overloaded free tiers hang)
# MAX_JOBS_PER_SESSION_PER_HOUR=0  # 0 = unlimited
# ALLOW_HD=true
